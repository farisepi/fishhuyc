[gd_scene format=3 uid="uid://culbxw5d3yscg"]

[sub_resource type="GDScript" id="GDScript_bqwbl"]
script/source = "extends Node2D

# ============================================
# ССЫЛКИ НА УЗЛЫ
# ============================================

@onready var text_label: RichTextLabel = $TextLabel
@onready var background: ColorRect = $Background
@onready var fade_overlay: ColorRect = $FadeOverlay
@onready var timer: Timer = $Timer

# ============================================
# _ready() - ПРИ ЗАГРУЗКЕ СЦЕНЫ
# ============================================

func _ready() -> void:
	# Настраиваем фон
	background.color = Color.BLACK
	fade_overlay.color = Color.BLACK
	fade_overlay.modulate.a = 0.0
	
	# Настраиваем текст
	text_label.text = \"Несколько дней спустя...\"
	text_label.visible_ratio = 0.0
	text_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	text_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	
	# Плавное появление
	if has_node(\"/root/Fade\"):
		Fade.fade_in()
		await get_tree().create_timer(0.3).timeout
	else:
		var tween = create_tween()
		tween.tween_property(fade_overlay, \"modulate:a\", 0.0, 0.5)
		await tween.finished
	
	# Анимация печатания текста
	var tween_text = create_tween()
	tween_text.tween_property(text_label, \"visible_ratio\", 1.0, 2.0)
	
	# Ждём 3 секунды
	await get_tree().create_timer(3.0).timeout
	
	# Затемняем экран
	if has_node(\"/root/Fade\"):
		Fade.fade_out()
		await Fade.fade_out
	else:
		var tween_fade = create_tween()
		tween_fade.tween_property(fade_overlay, \"modulate:a\", 1.0, 0.5)
		await tween_fade.finished
	
	# Устанавливаем флаг
	if has_node(\"/root/Global\"):
		Global.prologue1_completed = true
		Global.prologue2_completed = true
	
	# Переход в первый игровой уровень
	get_tree().change_scene_to_file(\"res://код/сцены/chase_level.tscn\")
"

