[sub_resource type="GDScript" id="GDScript_6k83o"]
script/source = "extends Control

@onready var image_display: TextureRect = $ImageDisplay
@onready var text_label: RichTextLabel = $TextLabel
@onready var slide_timer: Timer = $SlideTimer
@onready var background: ColorRect = $Background
@onready var fade_overlay = $FadeOverlay

var slides_texts = [
	\"ТЕСТ 1: Давным-давно...\",
	\"ТЕСТ 2: Подводная лаборатория...\",
	\"ТЕСТ 3: Опасные эксперименты...\",
]

var current_slide = 0

func _ready() -> void:
	print(\"=== TEST INTRO ===\")
	
	# ============================================
	# ПРИНУДИТЕЛЬНО РАСТЯГИВАЕМ ВСЕ УЗЛЫ
	# ============================================
	
	# Растягиваем Background на весь экран
	background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	background.color = Color.RED
	print(\"Background set to RED and stretched full screen\")
	
	# Растягиваем ImageDisplay на весь экран
	image_display.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	image_display.texture = null
	image_display.modulate = Color.BLUE
	print(\"ImageDisplay set to BLUE and stretched full screen\")
	
	# Растягиваем TextLabel на весь экран
	text_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	text_label.text = \"ТЕСТОВЫЙ ТЕКСТ\"
	text_label.add_theme_font_size_override(\"normal_font_size\", 48)
	text_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	text_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	text_label.add_theme_color_override(\"font_color\", Color.WHITE)
	print(\"Text label set\")
	
	# Отключаем затемнение
	fade_overlay.visible = false
	print(\"Fade overlay disabled\")
	
	print(\"Test ready - should see RED background, BLUE center, WHITE text\")
"

