[sub_resource type="GDScript" id="GDScript_v16hl"]
script/source = "extends StaticBody2D

@export var move_distance: float = 10.0
@export var passage_trigger: Area2D = null

var detection_area: Area2D = null

func _ready():
	# Ищем дочерний Area2D
	detection_area = get_node_or_null(\"DetectionArea\")
	if detection_area:
		detection_area.body_entered.connect(_on_body_entered)
	else:
		print(\"❌ НЕТ ДОЧЕРНЕГО AREA2D! СОЗДАЙ DetectionArea ВНУТРИ\")

func _on_body_entered(body: Node2D):
	if body.name == \"Mecha_Fish\" and passage_trigger and not passage_trigger.is_active:
		print(\"🔔 ИГРОК У ПРЕПЯТСТВИЯ!\")
		passage_trigger.activate(body)
"

